# Sans DATABASE_URL, le serveur utilise SQLite (dev/test uniquement).
# Production : PostgreSQL 14+ (extension btree_gist requise).
DATABASE_URL=postgres://soloc:CHANGE_ME@localhost:5432/soloc
SQLITE_FILE=data/soloc.db
PORT=3000
NODE_ENV=development
PENDING_TTL_HOURS=24
# Comptes créés par `npm run seed` (si vides : mots de passe aléatoires affichés une fois)
SEED_ADMIN_EMAIL=admin@soloc.test
SEED_ADMIN_PASSWORD=
# Anti-accaparement : demandes en attente maximum par client (défaut 3)
MAX_PENDING_PER_USER=3
# Derrière un reverse proxy de confiance uniquement : lit l'IP réelle dans X-Forwarded-For (limitation des tentatives)
TRUST_PROXY=0
# --- Production : voir .env.production.example et docs/DEPLOY.md ---
PUBLIC_URL=http://localhost:3000
PAYMENTS_MODE=off
NOTIFY_MODE=off
LOG_REQUESTS=0
